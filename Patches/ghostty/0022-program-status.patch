+/// One OSC 7501 report, reduced to what a status indicator shows: the
+/// state, what a blocked program waits for, and the progress. The id,
+/// app, title and message stay in the terminal; a report replaces the
+/// previous one.
+pub const ProgramStatus = struct {
+    state: terminal.osc.Command.ProgramStatus.State,
+    kind: ?terminal.osc.Command.ProgramStatus.Kind,
+    progress: ?u8,
+
+    pub fn init(report: terminal.osc.Command.ProgramStatus.Report) ProgramStatus {
+        return .{
+            .state = report.state,
+            .kind = report.readOption(.kind),
+            .progress = report.readOption(.progress),
+        };
+    }
+
+    /// sync with ghostty_action_program_status_s in ghostty.h
+    pub const C = extern struct {
+        state: c_int,
+        // -1 when the report carries no kind
+        kind: c_int,
+        // -1 when the report carries no progress, otherwise 0-100
+        progress: i8,
+    };
+
+    pub fn cval(self: ProgramStatus) C {
+        return .{
+            .state = @backingInt(self.state),
+            .kind = if (self.kind) |kind| @backingInt(kind) else -1,
+            .progress = if (self.progress) |progress| @intCast(@min(progress, 100)) else -1,
+        };
+    }
+};
