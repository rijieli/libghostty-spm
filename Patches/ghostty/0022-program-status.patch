+
+    /// OSC 7501: forward a report to the apprt, and answer the support
+    /// query with the fixed list of states and kinds this build accepts.
+    fn programStatus(self: *StreamHandler, cmd: terminal.osc.Command.ProgramStatus) void {
+        switch (cmd) {
+            .report => |report| {
+                const data = apprt.surface.Message.WriteReq.init(self.alloc, report.data) catch |err| {
+                    log.warn("failed to copy program status: {}", .{err});
+                    return;
+                };
+                self.surfaceMessageWriter(.{ .program_status = .{ .state = report.state, .data = data } });
+            },
+            .query => |terminator| switch (terminator) {
+                inline else => |t| self.messageWriter(.{
+                    .write_stable = "\x1b]7501;" ++
+                        terminal.osc.program_status.query_reply ++
+                        comptime t.string(),
+                }),
+            },
+        }
+    }
 };
 
